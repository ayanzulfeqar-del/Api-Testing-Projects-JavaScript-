    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\n\npm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Booking is successful\", function () {\n    pm.expect(jsonData.success).to.be.true;\n    pm.expect(jsonData.message).to.eql(\"Booking confirmed!\");\n});\n\npm.test(\"Booking details are correct\", function () {\n    pm.expect(jsonData.data).to.be.an(\"object\");\n    pm.expect(jsonData.data.id).to.be.a(\"number\");\n    pm.expect(jsonData.data.status).to.eql(\"confirmed\");\n    pm.expect(jsonData.data.customerEmail).to.be.a(\"string\");\n    pm.collectionVariables.set(\"booking_ref\",jsonData.data.bookingRef);\n   pm.environment.set(\"booking_id\", String(jsonData.data.id));\n});\n"
            ]
          }
        }
      ],
